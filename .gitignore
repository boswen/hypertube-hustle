# Crash reports
sysinfo.txt

# Addressables cache
/Assets/AddressableAssetsData/*/*.bin*

# Build artifacts
*.apk
*.aab
*.app
*.exe
*.unitypackage

# Misc
.DS_Store
Thumbs.db
Archive/
Imports/
